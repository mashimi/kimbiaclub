  "devDependencies": {
    "mobilewright": "^0.1.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "mobile",
    "flutter",
    "mobilenext",
    "mobilewright",
    "running-club",
    "tanzania"
  ],
