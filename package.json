{
  "name": "kimbiaclub",
  "version": "1.0.0",
  "description": "Kimbia TZ — League of Tanzanian Running Clubs Mobile App & Web Platform",
  "scripts": {
    "mobile:get": "cd mobile && flutter pub get",
    "mobile:analyze": "cd mobile && flutter analyze",
